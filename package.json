{
  "name": "skill-setu",
  "version": "1.0.0",
  "private": true,
  "description": "Skill Setu - AI Skill Intelligence & Learning Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace=@skill-setu/web",
    "dev:api": "npm run dev --workspace=@skill-setu/api",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=@skill-setu/shared",
    "build:api": "npm run build --workspace=@skill-setu/api",
    "build:web": "npm run build --workspace=@skill-setu/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=@skill-setu/api",
    "prisma:seed": "npm run prisma:seed --workspace=@skill-setu/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=@skill-setu/api"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.14.0",
    "@skill-setu/shared": "*",
    "@supabase/supabase-js": "^2.43.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.14.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
