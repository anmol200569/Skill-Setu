# ==============================================================================
# Skill Setu - Environment Variables Configuration Template
# Never commit real credentials or actual API keys to version control.
# Copy this file to .env in root or into specific apps (apps/api/.env, apps/web/.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend (apps/api)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Supabase PostgreSQL Connection String (Transaction Pooler or Direct)
# Example: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skill_setu?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/skill_setu?schema=public"

# Supabase Project Credentials (Server-side)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Initial Administrator Bootstrap Email
INITIAL_ADMIN_EMAIL=admin@skillsetu.dev

# ------------------------------------------------------------------------------
# Frontend (apps/web)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api/v1
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_APP_ENV=development
